{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"strict": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"skipLibCheck": false,
		"allowJs": false,
		"paths": {
			"widgetarium": [
				"./widgets/types/widgetarium.d.ts"
			]
		}
	},
	"include": [
		"widgets/types/**/*.d.ts",
		"tools/type-gate/**/*.ts",
		"widgets/**/*.tsx"
	]
}
