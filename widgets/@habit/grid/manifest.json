{
	"id": "@habit/grid",
	"title": "Habit grid",
	"description": "Every habit as a row of days you press to keep, with its streak beside it.",
	"keywords": [
		"habit",
		"grid",
		"streak",
		"days",
		"check",
		"tick",
		"tracker",
		"routine",
		"daily",
		"board",
		"rows",
		"keep"
	],
	"defaultSize": {
		"w": 13,
		"h": 5
	},
	"collapseBelowPx": 300,
	"sources": {
		"habits": {
			"label": "Habits",
			"default": {
				"path": "Habits"
			}
		}
	},
	"slots": {
		"row": {
			"of": "widget",
			"default": "@habit/habit-row",
			"gives": {
				"habit": [
					"name",
					"title",
					"color",
					"entries",
					"maxGap",
					"goal"
				]
			}
		}
	},
	"settings": [
		{
			"key": "days",
			"type": "number",
			"label": "How many days to show",
			"default": 14
		},
		{
			"key": "field",
			"type": "text",
			"label": "Property holding the dates",
			"default": "entries"
		},
		{
			"key": "maxGap",
			"type": "number",
			"label": "Missed days a streak survives",
			"default": 0
		},
		{
			"key": "square",
			"type": "boolean",
			"label": "Square marks instead of round",
			"default": false
		}
	],
