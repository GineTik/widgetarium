{
	"id": "@orbitask/filter-panel",
	"title": "OrbiTask · Filter",
	"defaultSize": {
		"w": 3,
		"h": 1
	},
	"maxSize": {
		"h": 1
	},
	"provides": [
		"filters"
	],
	"sources": {
		"tasks": {
			"label": "Tasks",
			"default": {
				"path": "Orbitask/Tasks",
				"filters": [
					{
						"prop": "board",
						"op": "is",
						"value": "@board"
					}
				]
			}
		}
	},
	"consumes": [
		"board"
	],
	"settings": [
		{
			"key": "groups",
			"type": "text",
			"label": "Filter by — empty means the board's own property list",
			"default": ""
		},
		{
			"key": "openGroup",
			"type": "text",
			"label": "Open by default",
			"default": ""
		},
		{
			"key": "key",
			"type": "text",
			"label": "Writes to",
			"default": "filters"
		}
	]
}
