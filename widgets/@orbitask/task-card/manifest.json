{
	"id": "@orbitask/task-card",
	"title": "OrbiTask · Task card",
	"defaultSize": {
		"w": 4,
		"h": 2
	},
	"collapseBelowPx": 90,
	"accepts": {
		"task": {
			"required": [
				"title"
			],
			"optional": [
				"tag",
				"priority",
				"status",
				"progress",
				"initials",
				"due",
				"files"
			]
		}
	},
	"settings": [
		{
			"key": "title",
			"label": "Title",
			"type": "text",
			"default": "Design the onboarding flow"
		},
		{
			"key": "tagColour",
			"label": "Tag colour — error, warning, success, info",
			"type": "text",
			"default": "error"
		},
		{
			"key": "priority",
			"label": "Priority — P1, P2, P3",
			"type": "text",
			"default": "P1"
		},
		{
			"key": "status",
			"label": "Status — approve, check, reject, review",
			"type": "text",
			"default": "approve"
		},
		{
			"key": "progress",
			"label": "Progress %",
			"type": "number",
			"default": 60
		},
		{
			"key": "dueDate",
			"label": "Deadline",
			"type": "text",
			"default": "12 Aug"
		},
		{
			"key": "attachments",
			"label": "Attachments",
			"type": "number",
			"default": 2
		},
		{
			"key": "initials",
			"label": "Assignee initials, comma separated",
			"type": "text",
			"default": "A, M, T"
		}
	],
	"preview": {
		"size": {
			"w": 4,
			"h": 3
		},
		"settings": {
			"title": "Design the onboarding flow",
			"priority": "P1",
			"status": "Check",
			"progress": 34,
			"initials": "Alex Morgan, Maya Chen",
			"tagColour": "error",
			"dueDate": "30 Aug",
			"attachments": 2
		}
	}
}
