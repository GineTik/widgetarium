{
	"id": "@task/view-tabs",
	"title": "View tabs",
	"description": "A row of tabs that picks which view a view group draws.",
	"keywords": [
		"view",
		"views",
		"tabs",
		"switch",
		"kanban",
		"table",
		"picker",
		"navigation",
		"bar",
		"modes",
		"layout"
	],
	"defaultSize": {
		"w": 13,
		"h": 1
	},
	"maxSize": {
		"h": 1
	},
	"collapseBelowPx": 90,
	"provides": [
		"view"
	],
	"consumes": [
		"views"
	],
	"settings": [
		{
			"key": "views",
			"type": "text",
			"label": "Views — only used when no group publishes its own",
			"default": "Kanban, Archived columns"
		},
		{
			"key": "activeView",
			"type": "text",
			"label": "Selected view",
			"default": "Kanban"
		}
	],
	"preview": {
		"size": {
			"w": 3,
			"h": 1
		},
		"settings": {
			"views": "Kanban, Archived columns",
			"activeView": "Kanban"
		}
	}
}
