{
	"id": "@task/task-card",
	"title": "Task card",
	"description": "One task as a card: title, tags, priority, progress, deadline and who is on it.",
	"keywords": [
		"task",
		"card",
		"tile",
		"todo",
		"item",
		"ticket",
		"issue",
		"priority",
		"tag",
		"assignee",
		"progress",
		"due",
		"deadline",
		"avatar"
	],
	"defaultSize": {
		"w": 4,
		"h": 2
	},
	"collapseBelowPx": 90,
	"accepts": {
		"task": {
			"required": [
				"title"
			],
			"optional": [
				"tags",
				"tagTones",
				"priority",
				"status",
				"progress",
				"initials",
				"due",
				"files"
			]
		}
	},
	"settings": [
		{
			"key": "title",
			"label": "Title",
			"type": "text",
			"default": "Design the onboarding flow"
		},
		{
			"key": "tags",
			"label": "Tags, comma separated",
			"type": "text",
			"default": "design, research"
		},
		{
			"key": "tagTones",
			"label": "Tag colours — tag: neutral, accent, success, warning, error, info, note or standout",
			"type": "text",
			"default": "design: warning, research: accent"
		},
		{
			"key": "priority",
			"label": "Priority — P1, P2, P3",
			"type": "text",
			"default": "P1"
		},
		{
			"key": "status",
			"label": "Status — approve, check, reject, review",
			"type": "text",
			"default": "approve"
		},
		{
			"key": "progress",
			"label": "Progress %",
			"type": "number",
			"default": 60
		},
		{
			"key": "dueDate",
			"label": "Deadline",
			"type": "text",
			"default": "12 Aug"
		},
		{
			"key": "attachments",
			"label": "Attachments",
			"type": "number",
			"default": 2
		},
		{
			"key": "initials",
			"label": "Assignee initials, comma separated",
			"type": "text",
			"default": "A, M, T"
		}
	],
	"preview": {
		"size": {
			"w": 4,
			"h": 2
		},
		"settings": {
			"title": "Record the release notes",
			"priority": "P3",
			"status": "Approve",
			"progress": 80,
			"initials": "Dana Reid",
			"dueDate": "4 Sep",
			"attachments": 1,
			"tags": "launch, notes",
			"tagTones": "launch: accent"
		}
	}
}
