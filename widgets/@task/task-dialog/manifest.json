{
	"id": "@task/task-dialog",
	"title": "Task dialog",
	"description": "Opens the selected task full size, to edit its fields, dates and notes.",
	"keywords": [
		"task",
		"dialog",
		"modal",
		"detail",
		"details",
		"edit",
		"open",
		"popup",
		"form",
		"editor",
		"sheet",
		"panel",
		"inspector"
	],
	"defaultSize": {
		"w": 3,
		"h": 1
	},
	"maxSize": {
		"h": 1
	},
	"collapseBelowPx": 40,
	"consumes": [
		"task",
		"board",
		"columns"
	],
	"settings": [
		{
			"key": "columns",
			"type": "text",
			"label": "Status values — only used when no board publishes its own",
			"default": "To Do, Doing, Done"
		}
	],
	"sources": {
		"tasks": {
			"label": "Tasks",
			"default": {
				"path": "Orbitask/Tasks"
			}
		}
	},
	"preview": {
		"size": {
			"w": 3,
			"h": 2
		},
		"instead": "Opens over the board as a dialog"
	}
}
