{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"customConditions": ["source"],
		"lib": ["ES2022", "DOM"],
		"jsx": "preserve",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"exactOptionalPropertyTypes": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"tsBuildInfoFile": "../../node_modules/.cache/widgetarium/widgetarium.tsbuildinfo",
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"references": [{ "path": "../kit" }, { "path": "../core" }],
	"include": ["src/**/*.ts", "../core/src/*.d.ts"]
}
