{
	"name": "widgetarium",
	"version": "0.1.0",
	"description": "What a widget imports: the widget API, the kit, its emojis and charts",
	"license": "FSL-1.1-ALv2",
	"type": "module",
	"engines": {
		"node": ">=20.12"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./kit": {
			"source": "./src/kit.ts",
			"types": "./dist/kit.d.ts",
			"default": "./dist/kit.js"
		},
		"./kit/emojis": {
			"source": "./src/kit-emojis.ts",
			"types": "./dist/kit-emojis.d.ts",
			"default": "./dist/kit-emojis.js"
		},
		"./kit/charts": {
			"source": "./src/kit-charts.ts",
			"types": "./dist/kit-charts.d.ts",
			"default": "./dist/kit-charts.js"
		},
		"./app": {
			"source": "./src/app.ts",
			"types": "./dist/app.d.ts",
			"default": "./dist/app.js"
		},
		"./studio": {
			"source": "./src/studio.ts",
			"types": "./dist/studio.d.ts",
			"default": "./dist/studio.js"
		},
		"./styles.css": {
			"style": "./dist/styles.css",
			"default": "./dist/styles.css"
		},
		"./studio.css": {
			"style": "./dist/studio.css",
			"default": "./dist/studio.css"
		}
	},
	"dependencies": {
		"@widgetarium/core": "0.1.0",
		"@widgetarium/kit": "0.1.0",
		"@widgetarium/pack-catalogue": "0.1.0",
		"@widgetarium/pack-core": "0.1.0"
	},
	"peerDependencies": {
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"zod": "^4.6.5"
	}
}
