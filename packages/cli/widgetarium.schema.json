{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"name": {
			"deprecated": true,
			"description": "moved to app.name",
			"type": "string",
			"minLength": 1
		},
		"app": {
			"default": {},
			"type": "object",
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1
				},
				"icon": {
					"default": "public/icon.svg",
					"type": "string"
				}
			},
			"additionalProperties": false,
			"required": ["name"]
		},
		"paths": {
			"default": {},
			"type": "object",
			"properties": {
				"routes": {
					"default": "src/app/routes",
					"type": "string"
				},
				"widgets": {
					"default": "src/widgets",
					"type": "string"
				},
				"logic": {
					"default": "src/logic",
					"type": "string"
				},
				"schemas": {
					"default": "src/shared/schemas",
					"type": "string"
				},
				"sources": {
					"default": "src/shared/sources",
					"type": "string"
				},
				"kit": {
					"default": "src/shared/kit",
					"type": "string"
				},
				"libs": {
					"default": "src/shared/libs",
					"type": "string"
				},
				"docs": {
					"default": "docs",
					"type": "string"
				},
				"references": {
					"default": "docs/references",
					"type": "string"
				}
			},
			"additionalProperties": false
		},
		"aliases": {
			"type": "object",
			"propertyNames": {
				"type": "string",
				"pattern": "^@"
			},
			"additionalProperties": {
				"type": "string"
			}
		},
		"catalogue": {
			"type": "object",
			"properties": {
				"registries": {
					"default": [],
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				}
			},
			"additionalProperties": false
		}
	},
	"additionalProperties": false,
	"required": ["app"]
}
