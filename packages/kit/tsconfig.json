{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react",
		"jsxFactory": "h",
		"jsxFragmentFactory": "Fragment",
		"strict": false,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"allowJs": false
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"]
}
