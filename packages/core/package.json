{
	"name": "@widgetarium/core",
	"version": "0.1.0",
	"license": "FSL-1.1-ALv2",
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./app": {
			"source": "./src/app.ts",
			"types": "./dist/app.d.ts",
			"default": "./dist/app.js"
		},
		"./styles.css": {
			"style": "./dist/styles.css",
			"default": "./dist/styles.css"
		},
		"./*": {
			"source": "./src/*",
			"types": "./dist/*",
			"default": "./dist/*"
		}
	},
	"dependencies": {
		"@babel/parser": "^8.0.5",
		"@widgetarium/kit": "0.1.0",
		"sucrase": "^3.35.0",
		"tailwind-merge": "^3.7.0",
		"yaml": "^2.9.0",
		"zod": "^4.6.5"
	},
	"peerDependencies": {
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	}
}
