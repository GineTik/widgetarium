{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noImplicitOverride": true,
		"allowUnreachableCode": false,
		"allowUnusedLabels": false,
		"noEmit": true,
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"skipLibCheck": true,
		"allowJs": false,
		"paths": {
			"widgetarium": ["./types/widgetarium.d.ts"],
			"widgetarium/kit": ["../kit/src/index.ts"],
			"widgetarium/kit/emojis": ["../kit/src/emojis/emoji.tsx"],
			"widgetarium/kit/charts": ["../kit/src/charts/index.ts"],
			"@*/lib": ["../../registry/@*/lib"]
		}
	},
	"references": [{ "path": "../kit" }, { "path": "../core" }],
	"include": [
		"types/**/*.d.ts",
		"../../tools/type-gate/**/*.ts",
		"../../tools/type-gate/*.tsx",
		"../../registry/**/*.tsx"
	]
}
