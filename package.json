{
	"name": "widgetarium",
	"version": "0.1.0",
	"private": true,
	"description": "Adaptive widget tiles on a dot grid for Obsidian",
	"workspaces": [
		"apps/*",
		"packages/*",
		"packages/packs/*"
	],
